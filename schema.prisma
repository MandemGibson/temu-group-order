// ==========================================
// Temu Group-Order Platform — Prisma Schema
// ==========================================

// ==========================================
// Temu Group-Order Platform — Prisma Schema
// Written for Prisma ORM 7 conventions (verify
// against current docs if building with Prisma 8+,
// which is in Release Candidate as of writing).
// ==========================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------
// Enums
// ------------------------------------------

enum UserRole {
  buyer
  leader // a leader is still a buyer underneath — this just adds leader-only fields/permissions
  admin
}

enum LeaderOnboardingStatus {
  not_applied
  pending_review
  approved
  rejected
  suspended
}

enum PoolStatus {
  open
  funded
  ordered
  shipped
  delivered
  dead
}

enum ItemCostStatus {
  unpaid
  proof_uploaded   // buyer uploaded proof + confirmed "I've paid"
  funded           // leader independently confirmed receipt (two-sided lock-in)
  dropped          // missed the sub-deadline, never resolved
}

enum TransactionStatus {
  pending     // Moolre payment initiated, awaiting webhook confirmation
  paid        // Moolre confirmed payment; pending_split not yet disbursed
  disbursed   // pool succeeded — leader/platform shares paid out
  voided      // pool died — fee converted to buyer credit instead
  failed      // Moolre payment itself failed
}

enum CreditSourceType {
  dead_pool
  dropped_join
  join_fee_spend  // negative delta — credit consumed toward a new join fee
}

enum DisputeType {
  funded_dispute            // "I paid item cost but wasn't marked funded"
  delivery_dispute          // "I never received my item"
  fraud_report              // "leader ran off with item cost money"
  shipping_deadline_missed  // system-raised: leader didn't ship within 24-48h of close
}

enum DisputeStatus {
  open
  under_review
  resolved_buyer
  resolved_leader
  dismissed
}

// ------------------------------------------
// Core identity
// ------------------------------------------

model User {
  id                String   @id @default(uuid())
  phone             String   @unique
  phoneVerifiedAt   DateTime?
  email             String?  @unique
  emailVerifiedAt   DateTime?
  name              String
  role              UserRole @default(buyer)
  createdAt         DateTime @default(now())

  // Leader-specific fields — null/unused for plain buyers
  leaderOnboardingStatus   LeaderOnboardingStatus @default(not_applied)
  leaderOnboardingFeeTxId  String?                @unique
  ghanaCardNumber          String?
  ghanaCardImageUrl        String?
  selfieImageUrl           String?
  leaderApprovedAt         DateTime?
  leaderSuspendedAt        DateTime?
  leaderSuspendedReason    String?

  // Relations
  poolsLed         Pool[]        @relation("PoolLeader")
  poolJoins        PoolJoin[]
  transactions     Transaction[]
  creditLedger     BuyerCredit[]
  reviewsWritten   Review[]      @relation("ReviewAuthor")
  disputesRaised   Dispute[]     @relation("DisputeRaisedBy")

  @@index([role])
  @@index([leaderOnboardingStatus])
}

// ------------------------------------------
// Pools
// ------------------------------------------

model Pool {
  id                String     @id @default(uuid())
  leaderId          String
  leader            User       @relation("PoolLeader", fields: [leaderId], references: [id])
  isPlatformPool    Boolean    @default(false) // true = platform runs it directly, leaderId = a platform "house" account

  title             String
  itemScreenshotUrl String?
  category          String?

  // Pool economics
  targetPesewas          Int    // soft planning goal, not enforced
  minPerPersonPesewas     Int
  maxParticipants         Int
  joinFeePesewas          Int   // leader-set freely, lives here
  platformCommissionBps   Int   // basis points e.g. 1000 = 10%, agreed per leader/pool

  // Lifecycle
  status            PoolStatus @default(open)
  deadlineAt        DateTime          // join-window deadline: leader-set within 24h–3d of creation
  itemCostDeadlineHours Int           // leader-set per pool within 12-48h, applied to each PoolJoin once funded
  fundedAt          DateTime?
  orderedAt         DateTime?
  shipDeadlineAt    DateTime?         // fundedAt + 24–48h, computed on funding
  shippedAt         DateTime?
  trackingNumber    String?
  deliveredAt       DateTime?

  // Recreation chain (max one carry-over)
  recreatedFromId   String?    @unique
  recreatedFrom     Pool?      @relation("PoolRecreation", fields: [recreatedFromId], references: [id])
  recreatedInto     Pool?      @relation("PoolRecreation")
  recreateCount     Int        @default(0) // 0 = original, 1 = one recreation used

  createdAt         DateTime   @default(now())

  joins             PoolJoin[]
  reviews           Review[]

  @@index([status])
  @@index([leaderId])
  @@index([deadlineAt])
}

// A single buyer's participation in a single pool
model PoolJoin {
  id              String   @id @default(uuid())
  poolId          String
  pool            Pool     @relation(fields: [poolId], references: [id])
  buyerId         String
  buyer           User     @relation(fields: [buyerId], references: [id])

  // What they're buying
  itemScreenshotUrl String?
  contributionPesewas Int  // counts toward the pool's 350-floor / target
  editableUntilPaid   Boolean @default(true)

  // Join fee (this buyer's transaction)
  transactionId   String?  @unique
  transaction     Transaction? @relation(fields: [transactionId], references: [id])

  // Item cost — two-sided confirmation
  itemCostPesewas        Int?
  itemCostStatus          ItemCostStatus @default(unpaid)
  itemCostDeadlineAt      DateTime?
  proofOfPaymentUrl       String?
  buyerConfirmedPaidAt    DateTime?
  leaderConfirmedFundedAt DateTime?
  paymentReference        String?  // "{name}-{last4}"

  // Delivery — two-sided confirmation
  leaderMarkedDeliveredAt  DateTime?
  buyerConfirmedDeliveredAt DateTime?

  // Voluntary exit
  leftVoluntarilyAt       DateTime?

  joinedAt        DateTime @default(now())

  disputes        Dispute[]
  review          Review?

  @@unique([poolId, buyerId]) // one join per buyer per pool
  @@index([itemCostStatus])
}

// ------------------------------------------
// Money
// ------------------------------------------

// The join-fee transaction — one per PoolJoin
model Transaction {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])

  amountPesewas         Int
  status                TransactionStatus @default(pending)
  idempotencyKey        String   @unique
  moolreReference       String?  @unique

  // Split — computed at creation, disbursed only on pool success
  leaderSharePesewas    Int
  platformSharePesewas  Int
  disbursedAt           DateTime?
  voidedAt               DateTime?

  // How much of this payment came from platform credit vs fresh Moolre payment
  creditAppliedPesewas   Int      @default(0)
  moolrePaidPesewas      Int

  createdAt             DateTime @default(now())

  poolJoin               PoolJoin?

  @@index([status])
  @@index([userId])
}

// A buyer's spendable, non-cash credit balance — closed loop, never withdrawable.
// Single running balance per user (not lot-tracked) for simplicity.
model BuyerCredit {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  balancePesewas  Int      @default(0)
  updatedAt       DateTime @updatedAt

  ledgerEntries   CreditLedgerEntry[]
}

// Append-only log of what changed the balance and why — for support/audit purposes only.
// The balance above is the source of truth for spending; this table is never summed to derive it.
model CreditLedgerEntry {
  id              String   @id @default(uuid())
  creditId        String
  credit          BuyerCredit @relation(fields: [creditId], references: [id])
  deltaPesewas    Int      // positive = credited, negative = spent
  reason          CreditSourceType
  relatedTransactionId String?
  createdAt       DateTime @default(now())

  @@index([creditId])
}

// ------------------------------------------
// Trust
// ------------------------------------------

model Review {
  id          String   @id @default(uuid())
  poolId      String
  pool        Pool     @relation(fields: [poolId], references: [id])
  poolJoinId  String   @unique
  poolJoin    PoolJoin @relation(fields: [poolJoinId], references: [id])
  authorId    String
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  leaderId    String   // denormalized for fast leader-profile lookups

  rating      Int      // 1–5
  text        String?

  createdAt   DateTime @default(now())

  @@index([leaderId])
}

model Dispute {
  id            String        @id @default(uuid())
  poolJoinId    String?       // nullable — shipping_deadline_missed disputes are pool-level, not join-level
  poolJoin      PoolJoin?     @relation(fields: [poolJoinId], references: [id])
  poolId        String?       // set for pool-level disputes (e.g. shipping_deadline_missed)
  leaderId      String        // denormalized — always set, so leader-profile queries don't need a join

  raisedById    String?       // nullable — null means system-raised (e.g. background job)
  raisedBy      User?         @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  raisedBySystem Boolean      @default(false)

  type          DisputeType
  status        DisputeStatus @default(open)
  description   String?
  evidenceUrl   String?
  resolutionNote String?
  resolvedAt    DateTime?

  createdAt     DateTime      @default(now())

  @@index([status])
  @@index([type])
  @@index([leaderId])
}
